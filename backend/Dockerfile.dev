# syntax=docker/dockerfile:1

# Same base image docker-compose.dev.yml used to run directly - this just
# layers graphviz on top for `manage.py graph_models` (see the dev-only
# django_extensions app in config/settings/dev.py and the Makefile's
# schema-diagram target). Dependencies still install at container start
# (see docker-compose.dev.yml's command) - ./backend is bind-mounted, so
# baking a venv into the image here would just get shadowed.
FROM ghcr.io/astral-sh/uv:python3.14-alpine

RUN apk add --no-cache graphviz
