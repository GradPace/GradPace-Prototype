# Template for the production env file.
#
#   cp .env.prod.example .env.prod   &&   fill in the blanks
#
# .env.prod is gitignored (real secrets). Both compose services read this one
# file, so the DATABASE_* values (used by the Django backend) and the
# POSTGRES_* values (used by the postgres image) MUST describe the same
# database/user/password.

# --- settings selector -------------------------------------------------------
# config/settings/__init__.py: production -> prod.py. The image already sets
# this, but keep it here so `docker compose run` etc. behave the same.
PIPELINE=production

# --- Django core -----------------------------------------------------------
SECRET_KEY=
# Must match the backend's VIRTUAL_HOST in docker-compose.prod.yml.
ALLOWED_HOSTS=gradpace-api.steyaert.xyz
CSRF_TRUSTED_ORIGINS=https://gradpace-api.steyaert.xyz

# --- Database: consumed by the backend (prod.py get_secret) ---------------
DATABASE_ENGINE=postgresql
DATABASE_NAME=gradpace_db
DATABASE_USERNAME=gradpace
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Database: consumed by the postgres:17 image + its healthcheck -------
# Keep these three identical to DATABASE_NAME / DATABASE_USERNAME / DATABASE_PASSWORD.
POSTGRES_DB=gradpace_db
POSTGRES_USER=gradpace
POSTGRES_PASSWORD=

# --- Email: consumed by the backend (prod.py get_secret) -----------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=noreply@gradpace.steyaert.xyz
